    {"id": "02", "voice": "K", "text": "Сто сорок семь, вызов. Я же говорил — приедем лично.", "dur": 3.0,
     "screen": {"kind": "call", "text": "Неизвестный"}},
    {"id": "03", "voice": "R", "text": "Откуда? Я этот код вводил только в одном месте.", "dur": 2.6,
     "set": "courtyard_night", "cast": [{"who": "courier", "name": "Kur", "at": [2.0, 6.6, 0], "rot": 3.0}],
