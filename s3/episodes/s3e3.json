     "cam": {"from": [0.2, 0.0, 1.7], "to": [0.1, 0.6, 1.75], "look": [0, 2.2, 1.8], "look_to": [0, 2.2, 1.85], "lens": [35, 45]}},
    {"id": "06", "voice": "R", "text": "С доверенностью от меня. Которую я не писал.", "dur": 2.8,
